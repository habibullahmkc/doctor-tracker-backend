# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# MongoDB Atlas connection string (include the database name at the end)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor-tracker?retryWrites=true&w=majority

# ---- Auth ----
# Long random string (min 32 chars). Must match JWT_SECRET in the frontend.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=1d

# ---- CORS ----
# Frontend origin(s), comma-separated, no trailing slash
CLIENT_URL=http://localhost:1982

# ---- Local troubleshooting (optional, leave unset in production) ----
# If you see "querySrv ECONNREFUSED" locally, your OS DNS resolver is refusing SRV lookups.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- Seed (used by `npm run seed`) ----
SEED_ADMIN_EMAIL=admin@doctortracker.com
SEED_ADMIN_PASSWORD=Admin@123
